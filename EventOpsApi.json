      {
        "name": "Assignments - Create (Organizer assigns staff) -> saves assignmentId",
        "event": [
          {
            "listen": "test",
            "script": {
              "exec": [
                "pm.test('Status is 200/201', function () {",
                "  pm.expect([200, 201, 409]).to.include(pm.response.code);",
                "});",
                "",
                "// If duplicate (409), you may still continue; assignmentId won't be updated.",
                "if (pm.response.code !== 409) {",
                "  const json = pm.response.json();",
                "  const id = (json && (json.id || (json.data && json.data.id))) || null;",
                "  if (id) pm.collectionVariables.set('assignmentId', id);",
                "}"
              ],
              "type": "text/javascript"
            }
          }
        ],
        "request": {
          "method": "POST",
          "header": [
            { "key": "Authorization", "value": "Bearer {{accessToken}}" },
            { "key": "Content-Type", "value": "application/json" }
          ],
          "body": {
            "mode": "raw",
            "raw": "{\n  \"userId\": \"{{staffUserId}}\",\n  \"roleName\": \"Usher\"\n}"
          },
          "url": {
            "raw": "{{baseUrl}}/api/events/{{eventId}}/assignments",
            "host": ["{{baseUrl}}"],
            "path": ["api", "events", "{{eventId}}", "assignments"]
          }
        }
      },
