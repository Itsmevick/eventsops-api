      {
        "name": "Events - Create (Organizer) -> saves eventId",
        "event": [
          {
            "listen": "test",
            "script": {
              "exec": [
                "pm.test('Status is 200/201', function () {",
                "  pm.expect([200, 201]).to.include(pm.response.code);",
                "});",
                "",
                "const json = pm.response.json();",
                "const id = (json && (json.id || (json.data && json.data.id))) || null;",
                "if (id) pm.collectionVariables.set('eventId', id);"
              ],
              "type": "text/javascript"
            }
          }
        ],
        "request": {
          "method": "POST",
          "header": [
            { "key": "Authorization", "value": "Bearer {{accessToken}}" },
            { "key": "Content-Type", "value": "application/json" }
          ],
          "body": {
            "mode": "raw",
            "raw": "{\n  \"title\": \"Postman Created Event\",\n  \"description\": \"Event created via Postman collection\",\n  \"venue\": \"Nairobi\",\n  \"startAt\": \"2030-01-01T10:00:00.000Z\",\n  \"endAt\": \"2030-01-01T14:00:00.000Z\",\n  \"capacity\": 100\n}"
          },
          "url": {
            "raw": "{{baseUrl}}/api/events",
            "host": ["{{baseUrl}}"],
            "path": ["api", "events"]
          }
        }
      },
