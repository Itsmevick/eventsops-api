      {
        "name": "Auth - Register Staff (creates staffUserId)",
        "event": [
          {
            "listen": "test",
            "script": {
              "exec": [
                "pm.test('Status is 200/201', function () {",
                "  pm.expect([200, 201, 409]).to.include(pm.response.code);",
                "});",
                "",
                "// If already exists (409), you can still login with the same creds.",
                "if (pm.response.code !== 409) {",
                "  const json = pm.response.json();",
                "  if (json && json.id) {",
                "    pm.collectionVariables.set('staffUserId', json.id);",
                "  }",
                "}"
              ],
              "type": "text/javascript"
            }
          }
        ],
        "request": {
          "method": "POST",
          "header": [{ "key": "Content-Type", "value": "application/json" }],
          "body": {
            "mode": "raw",
            "raw": "{\n  \"name\": \"{{staffName}}\",\n  \"email\": \"{{staffEmail}}\",\n  \"password\": \"{{staffPassword}}\"\n}"
          },
          "url": {
            "raw": "{{baseUrl}}/api/auth/register",
            "host": ["{{baseUrl}}"],
            "path": ["api", "auth", "register"]
          }
        }
      },
