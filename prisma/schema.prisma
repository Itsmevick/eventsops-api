generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  ORGANIZER
  STAFF
}

enum EventStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  role         Role     @default(ORGANIZER)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  organizedEvents Event[]      @relation("OrganizerEvents")
  assignments     Assignment[]
  checkIns        CheckIn[]    @relation("CheckInsByUser")

  @@index([email])
}

model Event {
  id          String      @id @default(cuid())
  title       String
  description String?
  venue       String?
  startAt     DateTime
  endAt       DateTime
  capacity    Int         @default(0)
  status      EventStatus @default(DRAFT)
  organizerId String
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  organizer   User         @relation("OrganizerEvents", fields: [organizerId], references: [id], onDelete: Cascade)
  assignments Assignment[]
  checkIns    CheckIn[]

  @@index([organizerId])
  @@index([status])
  @@index([startAt])
}

model Assignment {
  id        String   @id @default(cuid())
  eventId   String
  userId    String
  roleName  String
  createdAt DateTime @default(now())

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([eventId, userId, roleName])
  @@index([eventId])
  @@index([userId])
}

model CheckIn {
  id                String   @id @default(cuid())
  eventId           String
  attendeeName      String
  attendeeEmail     String?
  checkedInByUserId String
  checkedInAt       DateTime @default(now())

  event       Event @relation(fields: [eventId], references: [id], onDelete: Cascade)
  checkedInBy User  @relation("CheckInsByUser", fields: [checkedInByUserId], references: [id], onDelete: Cascade)

  @@index([eventId])
  @@index([checkedInByUserId])
  @@index([checkedInAt])
}
